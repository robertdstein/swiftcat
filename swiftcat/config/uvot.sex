BACK_TYPE        AUTO
BACK_SIZE        64
BACK_FILTERSIZE  3

CHECKIMAGE_TYPE  NONE

MEMORY_OBJSTACK  30000
MEMORY_PIXSTACK  3000000
MEMORY_BUFSIZE   4096

VERBOSE_TYPE     QUIET
